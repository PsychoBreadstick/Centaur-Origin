{
    "name": "Undead",
    "description": "In your current state, you're quite undead, being weak to Smite and Instant Health, as well as being unable to swim. Moreover, Iron Golems and Villagers aren't able to trade with you. However, common hostile mobs feel indifferent towards you.",
    "type": "origins:multiple",
    "undead_group": {
        "type": "origins:entity_group",
        "group": "undead"
    },
    "mobs_ignore": {
        "condition": {
            "type": "origins:resource",
            "resource": "centaur:undead_aggro_counter",
            "comparison": "==",
            "compare_to": 0
        },
        "type": "apugli:mobs_ignore",
        "mob_condition": {
            "type": "origins:in_tag",
            "tag": "centaur:normal_hostile"
        }
    },
    "iron_golem_aggro": {
        "type": "origins:action_over_time",
        "interval": 100,
        "entity_action": {
            "type": "origins:execute_command",
            "command": "execute as @s run data modify entity @e[type=minecraft:iron_golem,limit=1,sort=random,distance=..18] AngryAt set from entity @s UUID"
        }
    },
    "prevent_villager": {
        "type": "origins:prevent_entity_use",
        "bientity_condition": {
            "type": "origins:target_condition",
            "condition": {
                "type": "origins:entity_type",
                "entity_type": "minecraft:villager"
            }
        }
    },
    "aggro_counter": {
        "type": "origins:resource",
        "min": 0,
        "max": 30,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },
    "aggro_add": {
        "type": "origins:self_action_on_hit",
        "target_condition": {
            "type": "origins:in_tag",
            "tag": "centaur:normal_hostile"
        },
        "entity_action": {
            "type": "origins:modify_resource",
            "resource": "centaur:undead_aggro_counter",
            "modifier": {
                "operation": "set_total",
                "value": 30
            }
        },
        "hud_render": {
            "should_render": true
        }
    },
    "aggro_subtract": {
        "condition": {
            "type": "origins:resource",
            "resource": "centaur:undead_aggro_counter",
            "comparison": ">",
            "compare_to": 0
        },
        "type": "origins:action_over_time",
        "interval": 20,
        "entity_action": {
            "type": "origins:modify_resource",
            "resource": "centaur:undead_aggro_counter",
            "modifier": {
                "operation": "addition",
                "value": -1
            }
        }
    }
}